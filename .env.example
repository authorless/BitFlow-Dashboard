# Database Configuration
DATABASE_URL="postgresql://bitflow:change-me@localhost:5432/bitcoin_db"

# PostgreSQL Settings (for Docker)
POSTGRES_DB=bitcoin_db
POSTGRES_USER=bitflow
POSTGRES_PASSWORD=change-me

# Application Settings
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# API Configuration
NUXT_TELEMETRY_DISABLED=1

# Market data (change only if you use a compatible Binance API mirror)
BINANCE_API_BASE_URL=https://api.binance.com/api/v3

# Enable only when every request passes through your trusted reverse proxy
TRUST_PROXY=false
